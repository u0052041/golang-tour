// ALB Controller 安裝 / 升級
// 用途：初次建叢集、升級 controller 版本時跑
pipeline {
    agent {
        kubernetes {
            namespace 'jenkins-agents'
            yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-agent
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
  - name: aws-tools
    image: 677856867919.dkr.ecr.ap-northeast-1.amazonaws.com/jenkins:latest
    imagePullPolicy: Always
    command: ["sleep", "infinity"]
    resources:
      requests:
        cpu: 200m
        memory: 512Mi
"""
        }
    }

    environment {
        CLUSTER_NAME = "main-eks"
        AWS_REGION   = "ap-northeast-1"
        SSM_PREFIX   = "/eks/main-eks"
    }

    stages {
        stage('Read SSM Parameters') {
            steps {
                container('aws-tools') {
                    script {
                        env.ALB_ROLE_ARN = sh(
                            script: "aws ssm get-parameter --name ${SSM_PREFIX}/alb-controller-role-arn --region ${AWS_REGION} --query Parameter.Value --output text",
                            returnStdout: true
                        ).trim()

                        env.VPC_ID = sh(
                            script: "aws ssm get-parameter --name ${SSM_PREFIX}/vpc-id --region ${AWS_REGION} --query Parameter.Value --output text",
                            returnStdout: true
                        ).trim()
                    }
                }
            }
        }

        stage('Configure kubectl') {
            steps {
                container('aws-tools') {
                    sh "aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${AWS_REGION} --kubeconfig /tmp/kubeconfig"
                }
            }
        }

        stage('Install ALB Controller') {
            steps {
                container('aws-tools') {
                    sh """
                        export KUBECONFIG=/tmp/kubeconfig
                        helm repo add eks https://aws.github.io/eks-charts
                        helm repo update
                        helm upgrade --install aws-load-balancer-controller eks/aws-load-balancer-controller \
                            --namespace kube-system \
                            --set clusterName=${CLUSTER_NAME} \
                            --set serviceAccount.create=true \
                            --set serviceAccount.name=aws-load-balancer-controller \
                            --set serviceAccount.annotations."eks\\.amazonaws\\.com/role-arn"=${env.ALB_ROLE_ARN} \
                            --set region=${AWS_REGION} \
                            --set vpcId=${env.VPC_ID}
                    """
                }
            }
        }

        stage('Verify') {
            steps {
                container('aws-tools') {
                    sh """
                        export KUBECONFIG=/tmp/kubeconfig
                        kubectl get deployment -n kube-system aws-load-balancer-controller
                    """
                }
            }
        }
    }
}
